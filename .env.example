# Vercel: public site configuration. Pump Money-specific names prevent stale project envs from leaking into the site.
NEXT_PUBLIC_LAUNCH_STATE=prelaunch
NEXT_PUBLIC_PMONEY_MINT=<PMONEY_SOURCE_TOKEN_MINT>
NEXT_PUBLIC_PUMP_MONEY_BUY_URL=<JUPITER_PMONEY_BUY_URL>
NEXT_PUBLIC_PUMP_MONEY_X_URL=<PUMP_MONEY_X_URL>
NEXT_PUBLIC_SITE_URL=https://pumpmoney.fun
NEXT_PUBLIC_SUPABASE_URL=<SUPABASE_URL>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>

# Railway: private worker configuration
WORKER_ENABLED=false
REWARD_MODE=token
HELIUS_RPC_URL=<PRIVATE_HELIUS_RPC_URL>
SOURCE_TOKEN_MINT=<PMONEY_SOURCE_TOKEN_MINT>
REWARD_TOKEN_MINT=<VERIFIED_PUMP_REWARD_MINT>
TREASURY_WALLET_SECRET=<ROTATED_PRIVATE_TREASURY_SECRET>
SUPABASE_URL=<SUPABASE_URL>
SUPABASE_SERVICE_ROLE=<PRIVATE_SUPABASE_SERVICE_ROLE>

# Keep all three false until the dry run and migration checks pass.
CLAIM_ENABLED=false
BUY_ENABLED=false
AIRDROP_ENABLED=false

# Pump Money round rules
EPOCH_MINUTES=5
ELIGIBILITY_MIN=100000
WINNERS_PER_EPOCH=10
MAX_HOLDER_PCT=5
EXCLUDE_WALLETS=<TREASURY_PUBLIC_ADDRESS>
SWAP_BALANCE_BPS=10000
REWARD_BUY_BPS=10000
SWAP_SLIPPAGE_BPS=300
MIN_SOL_RESERVE=0.3
AIRDROP_SOL_RESERVE=0.05
AIRDROP_BATCH_SIZE=4
AIRDROP_REWARD_BPS=10000
PRIORITY_FEE_SOL=0.000001
MIN_REWARD_RAW_TO_AIRDROP=1

# Add an extra program only if a validated Pump creator-fee transaction requires it.
CLAIM_ALLOWED_PROGRAM_IDS=
